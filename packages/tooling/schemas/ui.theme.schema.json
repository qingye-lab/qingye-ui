{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qingye.dev/schemas/ui.theme.schema.json",
  "title": "Qingye project theme",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "brand", "common", "light", "dark", "compact"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "brand": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$", "not": { "enum": ["light", "dark"] } },
    "common": { "$ref": "#/$defs/tokens" }, "light": { "$ref": "#/$defs/tokens" }, "dark": { "$ref": "#/$defs/tokens" }, "compact": { "$ref": "#/$defs/tokens" }
  },
  "$defs": { "tokens": { "type": "object", "propertyNames": { "pattern": "^--qy-[a-zA-Z0-9-]+$" }, "additionalProperties": { "type": "string", "minLength": 1 } } },
  "$comment": "Runtime validation also requires every token and reference to exist in the installed package/configured token registry, and CSS-safe values. This schema is not cascade/contrast acceptance."
}

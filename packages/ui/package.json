{
  "name": "@qingye_lab/ui",
  "version": "5.2.0",
  "description": "A React component library: accessible primitives, a layered design token system, and light/dark themes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./theme.css",
    "./motion.css",
    "./utilities.css",
    "./tokens/*.css",
    "./prose.css",
    "./dist/ui.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "import": "./dist/hooks/*.js",
      "default": "./dist/hooks/*.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js",
      "default": "./dist/locale.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js",
      "default": "./dist/locales/*.js"
    },
    "./theme.css": "./theme.css",
    "./styles.css": "./styles.css",
    "./motion.css": "./motion.css",
    "./prose.css": "./prose.css",
    "./ui.css": "./dist/ui.css",
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json",
    "./utilities.css": "./utilities.css",
    "./tokens/*": "./tokens/*",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "default": "./dist/utils.js"
    },
    "./floating-layer": {
      "types": "./dist/floating-layer.d.ts",
      "import": "./dist/floating-layer.js",
      "default": "./dist/floating-layer.js"
    },
    "./design.md": "./design.md",
    "./ai/*": "./ai/*",
    "./registry/*": "./registry/*",
    "./design.en.md": "./design.en.md"
  },
  "files": [
    "dist",
    "src",
    "tokens",
    "theme.css",
    "styles.css",
    "motion.css",
    "prose.css",
    "utilities.css",
    "catalog.json",
    "README.md",
    "LICENSE",
    "design.md",
    "design.en.md",
    "ai",
    "!ai/v0.4.0",
    "!ai/v1.0.0",
    "!ai/v2.0.0",
    "!ai/v3.0.0",
    "registry",
    "!ai/v4.0.0",
    "!ai/v4.1.0",
    "!ai/v4.2.0",
    "!ai/v5.0.0",
    "!ai/v5.1.0"
  ],
  "scripts": {
    "build": "pnpm gen:catalog && tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "check:pack": "node scripts/check-pack.mjs",
    "test": "vitest run",
    "gen:index": "node scripts/gen-index.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs",
    "check:api": "node scripts/check-api-drift.mjs"
  },
  "peerDependencies": {
    "@tanstack/react-table": "^8.21.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@daypicker/react": "10.0.2",
    "@tabler/icons-react": "^3.49.0",
    "@tanstack/react-virtual": "3.14.22",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "jsdom": "27.4.0",
    "postcss": "8.5.28",
    "publint": "0.3.25",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "3.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.0.16"
  },
  "keywords": [
    "react",
    "ui",
    "design-system",
    "components",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingye-lab/qingye-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/qingye-lab/qingye-ui",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}

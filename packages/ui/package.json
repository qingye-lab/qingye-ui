{
  "name": "@qingye/ui",
  "version": "1.0.0",
  "description": "A React component library: accessible primitives, a layered design token system, and light/dark themes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./theme.css",
    "./motion.css",
    "./utilities.css",
    "./tokens/*.css",
    "./dist/ui.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./theme.css": "./theme.css",
    "./styles.css": "./styles.css",
    "./motion.css": "./motion.css",
    "./ui.css": "./dist/ui.css",
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json",
    "./utilities.css": "./utilities.css",
    "./tokens/*": "./tokens/*",
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js"
    },
    "./floating-layer": {
      "types": "./dist/floating-layer.d.ts",
      "import": "./dist/floating-layer.js"
    },
    "./design.md": "./design.md",
    "./ai/*": "./ai/*",
    "./registry/*": "./registry/*",
    "./design.en.md": "./design.en.md"
  },
  "files": [
    "dist",
    "src",
    "tokens",
    "theme.css",
    "styles.css",
    "motion.css",
    "utilities.css",
    "catalog.json",
    "README.md",
    "LICENSE",
    "design.md",
    "design.en.md",
    "ai",
    "registry"
  ],
  "scripts": {
    "build": "pnpm gen:catalog && tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "pnpm build",
    "test": "vitest run",
    "gen:index": "node scripts/gen-index.mjs",
    "gen:catalog": "node scripts/gen-catalog.mjs"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@tanstack/react-table": "^8.21.3",
    "recharts": "^3.10.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@daypicker/react": "10.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.577.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "@types/react": "19.2.7",
    "postcss": "8.5.28",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "4.0.16",
    "jsdom": "27.4.0",
    "@testing-library/react": "16.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.2",
    "recharts": "3.10.1"
  },
  "keywords": [
    "react",
    "ui",
    "design-system",
    "components",
    "tailwind"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qingye-lab/qingye-ui.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/qingye-lab/qingye-ui",
  "publishConfig": {
    "access": "restricted"
  }
}

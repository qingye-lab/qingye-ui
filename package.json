{
  "name": "@yanqing/ui",
  "version": "0.1.0",
  "description": "A React component library: accessible primitives, a layered design token system, and light/dark themes.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./styles.css",
    "./theme.css",
    "./motion.css",
    "./components.css",
    "./dist/ui.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./extras": {
      "types": "./dist/extras.d.ts",
      "import": "./dist/extras.js"
    },
    "./locale": {
      "types": "./dist/locale.d.ts",
      "import": "./dist/locale.js"
    },
    "./locales/*": {
      "types": "./dist/locales/*.d.ts",
      "import": "./dist/locales/*.js"
    },
    "./theme.css": "./theme.css",
    "./styles.css": "./styles.css",
    "./motion.css": "./motion.css",
    "./components.css": "./components.css",
    "./ui.css": "./dist/ui.css",
    "./catalog.json": "./catalog.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "theme.css",
    "styles.css",
    "motion.css",
    "components.css",
    "catalog.json",
    "coss-source.json",
    "THIRD_PARTY_NOTICES.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:upstream": "node scripts/check-upstream.mjs",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@tanstack/react-table": "^8.21.3"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-table": {
      "optional": true
    }
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@daypicker/react": "10.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.577.0",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@tanstack/react-table": "8.21.3",
    "@types/react": "19.2.7",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3"
  },
  "keywords": ["react", "ui", "design-system", "components", "tailwind"]
}
